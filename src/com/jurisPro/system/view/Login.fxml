<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" styleClass="root" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jurisPro.system.controller.LoginController">
   <children>
      <VBox alignment="CENTER_LEFT" maxWidth="350.0" spacing="12.0" styleClass="login-container">
         <children>
            <Label styleClass="login-title" text="Iniciar Sesión" />
            
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="Usuario" />
                  <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="Contraseña" />
                  <PasswordField fx:id="txtPassword" promptText="Ingrese su contraseña" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="Rol" />
                  <ComboBox fx:id="cmbRol" maxWidth="1.179649318E308" promptText="Seleccione su rol" />
               </children>
            </VBox>
            
            <Button maxWidth="1.179649318E308" onAction="#handleLogin" styleClass="button-primary" text="Ingresar">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>