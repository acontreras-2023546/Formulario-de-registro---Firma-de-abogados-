<?xml version="1.0" encoding="UTF-8"?> <?import javafx.geometry.Insets?> <?import javafx.scene.control.Button?> <?import javafx.scene.control.Label?> <?import javafx.scene.control.Separator?> <?import javafx.scene.layout.BorderPane?> <?import javafx.scene.layout.HBox?> <?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jurisPro.system.controller.ClienteController">

<top>
    <HBox
        alignment="CENTER_LEFT"
        prefHeight="75.0"
        spacing="15.0"
        style="-fx-background-color: #2c3e50;">

        <padding>
            <Insets
                top="15.0"
                right="25.0"
                bottom="15.0"
                left="25.0"/>
        </padding>

        <VBox spacing="3.0">

            <Label
                text="JURISPRO"
                style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label
                text="Portal del Cliente"
                style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>

        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button
            fx:id="btnLogout"
            text="Cerrar Sesión"
            onAction="#handleLogout"
            prefHeight="38.0"
            style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-cursor: hand;"/>

    </HBox>
</top>

<center>
    <VBox
        spacing="25.0"
        style="-fx-background-color: #f4f6f7;">

        <padding>
            <Insets
                top="40.0"
                right="50.0"
                bottom="40.0"
                left="50.0"/>
        </padding>

        <VBox spacing="5.0">

            <Label
                text="Información de mi caso"
                style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Label
                text="Consulta el estado actual de tu proceso legal."
                style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

        </VBox>

        <VBox
            spacing="12.0"
            style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #e0e0e0; -fx-border-radius: 8px; -fx-padding: 25px;">

            <Label
                text="Información del Cliente"
                style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <HBox spacing="10.0">

                <Label
                    text="Cliente / Empresa:"
                    prefWidth="180.0"
                    style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                <Label
                    fx:id="lblNombreCliente"
                    text="Nombre del cliente"
                    style="-fx-text-fill: #555555;"/>

            </HBox>

        </VBox>

        <VBox
            spacing="12.0"
            style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #e0e0e0; -fx-border-radius: 8px; -fx-padding: 25px;">

            <Label
                text="Abogado Asignado"
                style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <HBox spacing="10.0">

                <Label
                    text="Nombre del Abogado:"
                    prefWidth="180.0"
                    style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                <Label
                    fx:id="lblNombreAbogado"
                    text="Abogado asignado"
                    style="-fx-text-fill: #555555;"/>

            </HBox>

        </VBox>

        <VBox
            spacing="12.0"
            style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #e0e0e0; -fx-border-radius: 8px; -fx-padding: 25px;">

            <Label
                text="Estado del Caso"
                style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <HBox
                alignment="CENTER_LEFT"
                spacing="10.0">

                <Label
                    text="Estado actual (registrado por el abogado):"
                    prefWidth="250.0"
                    style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                <Label
                    fx:id="lblEstadoCaso"
                    text="Cargando estado..."
                    style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>

            </HBox>

            <HBox
                alignment="CENTER_LEFT"
                spacing="10.0">

                <Label
                    text="Informe de avance del abogado:"
                    prefWidth="250.0"
                    style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                <Label
                    fx:id="lblDescripcionCaso"
                    text="Aquí aparecerá el último informe de avance guardado por el abogado."
                    wrapText="true"
                    style="-fx-text-fill: #555555;"/>

            </HBox>

        </VBox>

        <VBox
            alignment="CENTER"
            spacing="5.0">

            <Label
                text="JurisPro"
                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>

            <Label
                text="Sistema de Gestión Legal"
                style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>

        </VBox>

    </VBox>
</center>

</BorderPane>