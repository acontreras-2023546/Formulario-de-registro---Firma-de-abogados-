<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" 
            stylesheets="@../resources/styles/AdminStyles.css"
            xmlns="http://javafx.com/javafx/8" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jurispro.system.controller.AdminDashboardController">
    <top>
        <ToolBar styleClass="custom-toolbar" BorderPane.alignment="CENTER">
            <items>
                <Label styleClass="toolbar-title" text="Panel de Administración" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="btnLogout" onAction="#handleCerrarSesion" styleClass="button-logout" text="Cerrar Sesión" />
            </items>
        </ToolBar>
    </top>
    <center>
        <SplitPane dividerPositions="0.6" styleClass="custom-split-pane" BorderPane.alignment="CENTER">
            <items>
                <!-- LADO IZQUIERDO: Tabla de registros y filtro -->
                <VBox spacing="10.0" styleClass="panel-card">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="form-label" text="Filtrar por:" />
                                <ComboBox fx:id="cmbTipoUsuario" prefWidth="200.0" promptText="Abogados / Clientes / Empresas" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaUsuarios" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" text="ID / DPI" />
                                <TableColumn fx:id="colNombre" text="Nombre" />
                                <TableColumn fx:id="colRol" text="Rol" />
                                <TableColumn fx:id="colTelefono" text="Teléfono" />
                                <TableColumn fx:id="colAbogadoAsignado" text="Abogado Asignado" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- LADO DERECHO: Formulario completo con Scroll -->
                <ScrollPane fitToWidth="true" styleClass="custom-scroll-pane">
                    <content>
                        <VBox spacing="10.0" styleClass="panel-card">
                            <padding>
                                <Insets bottom="15" left="15" right="15" top="15" />
                            </padding>
                            <children>
                                <Label styleClass="section-title" text="Gestión de Registro" />
                                <Separator prefWidth="200.0" />
                        
                                <Label styleClass="form-label" text="Tipo de Registro:" />
                                <ComboBox fx:id="cmbFormTipo" prefWidth="250.0" />

                                <Label styleClass="form-label" text="DPI (Cliente):" />
                                <TextField fx:id="txtDpi" promptText="Obligatorio para Cliente" />

                                <Label styleClass="form-label" text="NIT:" />
                                <TextField fx:id="txtNit" promptText="Opcional / CF" />

                                <Label styleClass="form-label" text="Nombre:" />
                                <TextField fx:id="txtNombre" />

                                <Label styleClass="form-label" text="Apellido (Cliente):" />
                                <TextField fx:id="txtApellido" />

                                <Label styleClass="form-label" text="Teléfono:" />
                                <TextField fx:id="txtTelefono" />

                                <Label styleClass="form-label" text="Dirección:" />
                                <TextField fx:id="txtDireccion" />

                                <Label styleClass="form-label" text="Asignar Abogado (Clientes/Empresas):" />
                                <ComboBox fx:id="cmbAsignarAbogado" prefWidth="250.0" />

                                <Separator prefWidth="200.0" />
                                <Label styleClass="form-label" text="Contraseña:" />
                                <PasswordField fx:id="txtPassword" promptText="Ingrese contraseña" />

                                <Label styleClass="form-label" text="Confirmar Contraseña:" />
                                <PasswordField fx:id="txtConfirmPassword" promptText="Repita la contraseña" />

                                <Separator prefWidth="200.0" />
                                <VBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnCrear" onAction="#handleCrear" prefWidth="220.0" styleClass="button-primary" text="Crear Registro" />
                                        <Button fx:id="btnEditar" onAction="#handleEditar" prefWidth="220.0" styleClass="button-secondary" text="Guardar Cambios" />
                                        <Button fx:id="btnEliminar" onAction="#handleEliminar" prefWidth="220.0" styleClass="button-danger" text="Eliminar Registro" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>